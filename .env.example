# Vite / App
VITE_APP_NAME=Spider
VITE_NODE_ENV=development

# Cesium / 3D Tiles
VITE_CESIUM_ION_TOKEN=your_cesium_ion_token_here
VITE_THREEJS_GLTF_PATH=/assets/models

# Map / Tiles Providers (metered)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
VITE_BING_MAPS_KEY=your_bing_maps_key_here

# Telemetry feeds
VITE_ADSB_ENDPOINT=https://opensky-network.org/api
VITE_ADSB_API_KEY=

VITE_AIS_ENDPOINT=https://api.aishub.net
VITE_AIS_API_KEY=

VITE_TLE_SOURCE=https://celestrak.com/NORAD/elements/gp.php?GROUP=visual

VITE_CAMERA_REGISTRY_URL=https://example.com/cameras.json
VITE_CAMERA_API_KEY=

VITE_EARTHQUAKE_FEED=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_hour.geojson

VITE_OPENWEATHERMAP_KEY=

# Realtime AI / voice services
VITE_OPENAI_API_KEY=your_openai_api_key_here
VITE_VOICE_PROVIDER_URL=https://api.example-voice.ai
VITE_VOICE_PROVIDER_KEY=

# App behavior & toggles
VITE_ENABLE_TELEMETRY_CACHE=true
VITE_TELEMETRY_CACHE_DIR=./public/assets/tiles-cache
VITE_DEFAULT_VIEW_LAT=37.7749
VITE_DEFAULT_VIEW_LON=-122.4194
VITE_DEFAULT_VIEW_ALT=1000000

# Optional Sentry or Observability
VITE_SENTRY_DSN=

# Feature flags
VITE_FEATURE_FLIR=false
VITE_FEATURE_COCKPIT_MODE=true

